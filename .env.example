APP_NAME=SkyMedia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://skymedia.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skymedia
DB_USERNAME=skymedia
DB_PASSWORD=

CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log

# ── SkyMedia Core ──────────────────────────────────────────────
# Path to ffmpeg/ffprobe binaries (must have SRT support compiled in)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Base directory where DVR segments are stored on disk
DVR_BASE_PATH=/var/skymedia/dvr

# How often (seconds) the monitor daemon ticks between checks
SKYMEDIA_MONITOR_TICK=3

# SRT latency in milliseconds (applied to both ingest and push SRT)
SKYMEDIA_SRT_LATENCY=200

# Assumed max bitrate for DVR storage estimation (bits/sec)
SKYMEDIA_DVR_MAX_BITRATE=10000000

# User-Agent for HTTP(S) sources. Many HLS/IPTV endpoints require a browser UA.
# Set to empty to use FFmpeg's default.
SKYMEDIA_HTTP_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Set to true to enforce TLS certificate verification for HLS sources.
# Default is false because many IPTV/HLS endpoints use non-standard certs.
SKYMEDIA_HLS_TLS_VERIFY=false

# Minimum hours to keep completed recordings before they can be pruned.
# Default: 24 hours.
SKYMEDIA_MIN_RECORDING_RETENTION_HOURS=24
